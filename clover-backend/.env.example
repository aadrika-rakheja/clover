# ─────────────────────────────────────────────────────────────────────────────
# Clover Backend — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Runtime environment. Set to "production" in deployed environments.
NODE_ENV=development

# TCP port the Express API server listens on.
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection URI. Use a replica set URI in production.
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/clover
MONGODB_URI=mongodb://127.0.0.1:27017/clover

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Add your production frontend domain here.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── ML / Python Prediction Service ────────────────────────────────────────────
# Base URL of the FastAPI service that serves the trained PM2.5 forecast model.
# Both names are supported; PREDICTION_SERVICE_URL takes precedence.
# See: clover-backend/ml-service/app/main.py
PREDICTION_SERVICE_URL=http://localhost:8000
# ML_SERVICE_URL=http://localhost:8000  ← legacy alias, still works

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum log level. Options: error | warn | info | debug
# Use "debug" in development, "warn" or "error" in production.
LOG_LEVEL=info
